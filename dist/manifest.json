{
  "manifest_version": 3,
  "name": "OpenViscribe",
  "version": "2.0.14",
  "description": "OpenViscribe browser extension.",
  "permissions": [
    "storage",
    "scripting",
    "tabCapture",
    "tabs",
    "activeTab"
  ],
  "action": {
    "default_title": "OpenViscribe",
    "default_icon": {
      "16": "icons/openviscribe-16.png",
      "32": "icons/openviscribe-32.png",
      "48": "icons/openviscribe-48.png",
      "128": "icons/openviscribe-128.png"
    }
  },
  "icons": {
    "16": "icons/openviscribe-16.png",
    "32": "icons/openviscribe-32.png",
    "48": "icons/openviscribe-48.png",
    "128": "icons/openviscribe-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["click-ripple-content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
